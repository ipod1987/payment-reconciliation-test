            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/v1/reconciliation/pay_c001", "host": ["{{baseUrl}}"], "path": ["v1","reconciliation","pay_c001"] }
          }
        },
        {
          "name": "pay_c002 — Amazon EUR 199.99",
          "request": {
