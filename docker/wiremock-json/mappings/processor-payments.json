  "mappings": [

    {
      "name": "POST /auth/token - valid credentials -> token",
      "priority": 1,
      "request": {
        "method": "POST",
        "url": "/auth/token",
        "bodyPatterns": [
          { "matchesJsonPath": "$[?(@.username == 'reconciliation-service')]" },
          { "matchesJsonPath": "$[?(@.password == 'secret-2024')]" },
          { "matchesJsonPath": "$[?(@.channel == 'API')]" }
        ]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "access_token": "test-token-wiremock-2024",
          "token_type": "Bearer",
          "expires_in": 3600
        }
      }
    },

    {
      "name": "POST /auth/token - invalid credentials -> 401",
      "priority": 10,
      "request": {
        "method": "POST",
        "url": "/auth/token"
      },
      "response": {
        "status": 401,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "error": "INVALID_CREDENTIALS",
          "message": "Username, password or channel are incorrect"
        }
      }
    },

    {
      "name": "GET /payments/* - missing auth token -> 401",
      "priority": 10,
      "request": {
        "method": "GET",
        "urlPattern": "/payments/.*",
        "headers": {
          "Authorization": { "absent": true }
        }
      },
      "response": {
        "status": 401,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "error": "UNAUTHORIZED",
          "message": "Missing Authorization header. Obtain a token via POST /auth/token"
        }
      }
    },

